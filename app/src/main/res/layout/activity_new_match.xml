<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:layout_width="match_parent"
    android:layout_height="match_parent"

    android:fillViewport="true"

    android:background="?android:attr/colorBackground">

    <LinearLayout

        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:orientation="vertical"

        android:paddingBottom="20dp">


        <!-- ===================================================== -->
        <!-- TOOLBAR -->
        <!-- ===================================================== -->

        <androidx.appcompat.widget.Toolbar

            android:id="@+id/toolbar"

            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"

            android:background="?attr/colorPrimary"

            app:title="New Match"
            app:titleTextColor="@android:color/white" />


        <!-- ===================================================== -->
        <!-- CONTENT -->
        <!-- ===================================================== -->

        <LinearLayout

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:orientation="vertical"

            android:paddingStart="18dp"
            android:paddingTop="16dp"
            android:paddingEnd="18dp"
            android:paddingBottom="20dp">


            <!-- ================================================= -->
            <!-- HEADING -->
            <!-- ================================================= -->

            <TextView

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:text="NEW MATCH"

                android:textSize="18sp"
                android:textStyle="bold"

                android:textColor="?android:attr/textColorPrimary"

                android:layout_marginBottom="16dp" />


            <!-- ================================================= -->
            <!-- TEAM A -->
            <!-- ================================================= -->

            <TextView

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:text="TEAM A"

                android:textSize="11sp"
                android:textStyle="bold"

                android:textColor="?android:attr/textColorSecondary"

                android:layout_marginBottom="4dp" />


            <Spinner

                android:id="@+id/spinnerTeamA"

                android:layout_width="match_parent"
                android:layout_height="48dp"

                android:paddingStart="10dp"
                android:paddingEnd="10dp"

                android:layout_marginBottom="12dp" />


            <!-- ================================================= -->
            <!-- TEAM B -->
            <!-- ================================================= -->

            <TextView

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:text="TEAM B"

                android:textSize="11sp"
                android:textStyle="bold"

                android:textColor="?android:attr/textColorSecondary"

                android:layout_marginBottom="4dp" />


            <Spinner

                android:id="@+id/spinnerTeamB"

                android:layout_width="match_parent"
                android:layout_height="48dp"

                android:paddingStart="10dp"
                android:paddingEnd="10dp"

                android:layout_marginBottom="12dp" />


            <!-- ================================================= -->
            <!-- MATCH FORMAT -->
            <!-- ================================================= -->

            <TextView

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:text="MATCH FORMAT"

                android:textSize="11sp"
                android:textStyle="bold"

                android:textColor="?android:attr/textColorSecondary"

                android:layout_marginBottom="4dp" />


            <Spinner

                android:id="@+id/spinnerFormat"

                android:layout_width="match_parent"
                android:layout_height="48dp"

                android:paddingStart="10dp"
                android:paddingEnd="10dp"

                android:layout_marginBottom="12dp" />


            <!-- ================================================= -->
            <!-- OVERS -->
            <!-- ================================================= -->

            <com.google.android.material.textfield.TextInputLayout

                android:id="@+id/layoutOvers"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginBottom="12dp"
                android:hint="Enter overs"

                style="@style/InputField">

                <com.google.android.material.textfield.TextInputEditText

                    android:id="@+id/etOvers"

                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:inputType="number"

                    android:maxLines="1"
                    android:singleLine="true"

                    android:textSize="15sp"

                    android:paddingStart="12dp"
                    android:paddingEnd="12dp" />

            </com.google.android.material.textfield.TextInputLayout>





            <!-- ================================================= -->
            <!-- TOSS WINNER -->
            <!-- ================================================= -->

            <TextView

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:text="TOSS WINNER"

                android:textSize="11sp"
                android:textStyle="bold"

                android:textColor="?android:attr/textColorSecondary"

                android:layout_marginBottom="4dp" />


            <Spinner

                android:id="@+id/spinnerTossWinner"

                android:layout_width="match_parent"
                android:layout_height="48dp"

                android:paddingStart="10dp"
                android:paddingEnd="10dp"

                android:layout_marginBottom="12dp" />


            <!-- ================================================= -->
            <!-- TOSS DECISION -->
            <!-- ================================================= -->

            <TextView

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:text="ELECTS TO"

                android:textSize="11sp"
                android:textStyle="bold"

                android:textColor="?android:attr/textColorSecondary"

                android:layout_marginBottom="2dp" />


            <RadioGroup

                android:id="@+id/radioDecision"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:orientation="horizontal"

                android:layout_marginBottom="16dp">


                <RadioButton

                    android:id="@+id/radioBat"

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:text="Bat"

                    android:textSize="14sp"

                    android:checked="true"

                    android:layout_marginEnd="24dp" />


                <RadioButton

                    android:id="@+id/radioBowl"

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:text="Bowl"

                    android:textSize="14sp" />

            </RadioGroup>


            <!-- ================================================= -->
            <!-- SELECT PLAYING XI -->
            <!-- ================================================= -->

            <com.google.android.material.button.MaterialButton

                android:id="@+id/btnProceed"

                android:layout_width="match_parent"
                android:layout_height="52dp"

                android:text="SELECT PLAYING XI"

                android:textSize="14sp"
                android:textStyle="bold"

                android:gravity="center"

                app:cornerRadius="9dp" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>