<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/primary"
        app:title="Live Scoring"
        app:titleTextAppearance="@style/Toolbar.Title"
        app:navigationIcon="@drawable/ic_back" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Scoreboard -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@color/primary_dark"
                android:padding="18dp">

                <TextView
                    android:id="@+id/tvBattingTeam"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#DCEFDC"
                    android:textSize="14sp"
                    tools:text="RCB innings" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="4dp">

                    <TextView
                        android:id="@+id/tvScore"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/white"
                        android:textStyle="bold"
                        android:textSize="34sp"
                        tools:text="142/3" />

                    <TextView
                        android:id="@+id/tvOvers"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:textColor="#DCEFDC"
                        android:textSize="16sp"
                        tools:text="(15.4 / 20 ov)" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="10dp">

                    <TextView
                        android:id="@+id/tvCRR"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:textColor="#DCEFDC"
                        android:textSize="13sp"
                        tools:text="CRR: 9.06" />

                    <TextView
                        android:id="@+id/tvTarget"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:textColor="#DCEFDC"
                        android:textSize="13sp"
                        tools:text="Need 45 off 30 balls" />
                </LinearLayout>
            </LinearLayout>

            <!-- Batsmen / Bowler panel -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingBottom="6dp">

                        <TextView android:layout_width="0dp" android:layout_weight="2" android:layout_height="wrap_content" style="@style/SectionHeading" android:text="BATTER" />
                        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" style="@style/SectionHeading" android:gravity="center" android:text="R" />
                        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" style="@style/SectionHeading" android:gravity="center" android:text="B" />
                        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" style="@style/SectionHeading" android:gravity="center" android:text="SR" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/rowStriker"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingVertical="4dp">

                        <TextView android:id="@+id/tvStrikerName" android:layout_width="0dp" android:layout_weight="2" android:layout_height="wrap_content" android:textStyle="bold" android:textColor="@color/text_primary" tools:text="* Virat Kohli" />
                        <TextView android:id="@+id/tvStrikerRuns" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:gravity="center" tools:text="72" />
                        <TextView android:id="@+id/tvStrikerBalls" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:gravity="center" tools:text="48" />
                        <TextView android:id="@+id/tvStrikerSR" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:gravity="center" tools:text="150.0" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/rowNonStriker"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingVertical="4dp">

                        <TextView android:id="@+id/tvNonStrikerName" android:layout_width="0dp" android:layout_weight="2" android:layout_height="wrap_content" android:textColor="@color/text_primary" tools:text="Faf du Plessis" />
                        <TextView android:id="@+id/tvNonStrikerRuns" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:gravity="center" tools:text="35" />
                        <TextView android:id="@+id/tvNonStrikerBalls" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:gravity="center" tools:text="29" />
                        <TextView android:id="@+id/tvNonStrikerSR" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:gravity="center" tools:text="120.6" />
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider" android:layout_marginVertical="10dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingBottom="6dp">

                        <TextView android:layout_width="0dp" android:layout_weight="2" android:layout_height="wrap_content" style="@style/SectionHeading" android:text="BOWLER" />
                        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" style="@style/SectionHeading" android:gravity="center" android:text="O" />
                        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" style="@style/SectionHeading" android:gravity="center" android:text="R" />
                        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" style="@style/SectionHeading" android:gravity="center" android:text="W" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingVertical="4dp">

                        <TextView android:id="@+id/tvBowlerName" android:layout_width="0dp" android:layout_weight="2" android:layout_height="wrap_content" android:textStyle="bold" android:textColor="@color/text_primary" tools:text="Mohammed Siraj" />
                        <TextView android:id="@+id/tvBowlerOvers" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:gravity="center" tools:text="3.4" />
                        <TextView android:id="@+id/tvBowlerRuns" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:gravity="center" tools:text="28" />
                        <TextView android:id="@+id/tvBowlerWickets" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:gravity="center" tools:text="2" />
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider" android:layout_marginVertical="8dp" />

                    <TextView
                        android:id="@+id/tvPartnership"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp"
                        tools:text="Partnership: 45 runs (32 balls)" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- This over -->
            <TextView
                style="@style/SectionHeading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:text="THIS OVER" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:paddingHorizontal="16dp">

                <LinearLayout
                    android:id="@+id/layoutThisOver"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <!-- Scoring buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="4"
                    android:rowCount="2">

                    <Button android:id="@+id/btn0" style="@style/ScoreButton" android:layout_columnWeight="1" android:background="@drawable/bg_btn_zero" android:textColor="@color/white" android:text="0" />
                    <Button android:id="@+id/btn1" style="@style/ScoreButton" android:layout_columnWeight="1" android:background="@drawable/bg_btn_one" android:textColor="@color/white" android:text="1" />
                    <Button android:id="@+id/btn2" style="@style/ScoreButton" android:layout_columnWeight="1" android:background="@drawable/bg_btn_two" android:textColor="@color/white" android:text="2" />
                    <Button android:id="@+id/btn3" style="@style/ScoreButton" android:layout_columnWeight="1" android:background="@drawable/bg_btn_three" android:textColor="@color/white" android:text="3" />

                    <Button android:id="@+id/btn4" style="@style/ScoreButton" android:layout_columnWeight="1" android:background="@drawable/bg_btn_four" android:textColor="@color/white" android:text="4" />
                    <Button android:id="@+id/btn6" style="@style/ScoreButton" android:layout_columnWeight="1" android:background="@drawable/bg_btn_six" android:textColor="@color/white" android:text="6" />
                    <Button android:id="@+id/btnWicket" style="@style/ScoreButton" android:layout_columnWeight="1" android:background="@drawable/bg_btn_wicket" android:textColor="@color/white" android:text="@string/wicket" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnUndo"
                        style="@style/ScoreButton"
                        android:layout_width="0dp"
                        android:layout_columnWeight="1"
                        app:strokeColor="@color/primary"
                        app:strokeWidth="1.5dp"
                        android:backgroundTint="@color/surface"
                        app:icon="@drawable/ic_undo"
                        app:iconTint="@color/primary"
                        app:iconGravity="textStart"
                        app:iconPadding="2dp"
                        android:textSize="12sp"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        android:textColor="@color/primary"
                        android:text="UNDO" />

                </GridLayout>

                <GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:columnCount="4"
                    android:rowCount="1">

                    <Button android:id="@+id/btnWide" style="@style/ScoreButton" android:layout_columnWeight="1" android:background="@drawable/bg_btn_extra" android:textColor="@color/white" android:text="@string/wide" />
                    <Button android:id="@+id/btnNoBall" style="@style/ScoreButton" android:layout_columnWeight="1" android:background="@drawable/bg_btn_extra" android:textColor="@color/white" android:text="@string/no_ball" />
                    <Button android:id="@+id/btnBye" style="@style/ScoreButton" android:layout_columnWeight="1" android:background="@drawable/bg_btn_extra" android:textColor="@color/white" android:text="@string/bye" />
                    <Button android:id="@+id/btnLegBye" style="@style/ScoreButton" android:layout_columnWeight="1" android:background="@drawable/bg_btn_extra" android:textColor="@color/white" android:text="@string/leg_bye" />

                </GridLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnPauseMatch"
                        style="@style/OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="4dp"
                        android:text="Pause Match" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnRetireHurt"
                        style="@style/OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="2dp"
                        android:text="Retire Batter" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnRetireBowler"
                        style="@style/OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:text="Retire Bowler" />
                </LinearLayout>

            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
