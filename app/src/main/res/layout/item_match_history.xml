<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            android:id="@+id/tvMatchDate"
            style="@style/CardSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="05 Aug 2026" />

        <TextView
            android:id="@+id/tvTeamsLine"
            style="@style/CardTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            tools:text="RCB vs MI" />

        <TextView
            android:id="@+id/tvScoreLine"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            tools:text="RCB 186/4 (20.0)  ·  MI 172/8 (20.0)" />

        <TextView
            android:id="@+id/tvResultLine"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/win_green"
            android:textStyle="bold"
            android:textSize="13sp"
            tools:text="RCB won by 14 runs" />
    </LinearLayout>
</androidx.cardview.widget.CardView>
