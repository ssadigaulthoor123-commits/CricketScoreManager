<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"

    android:layout_width="match_parent"
    android:layout_height="match_parent"

    android:orientation="vertical"

    android:background="@color/background">


    <!-- ========================================================= -->
    <!-- TOOLBAR -->
    <!-- ========================================================= -->

    <androidx.appcompat.widget.Toolbar

        android:id="@+id/toolbar"

        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"

        android:background="@color/primary"

        app:title="@string/select_playing_xi"
        app:titleTextAppearance="@style/Toolbar.Title"
        app:navigationIcon="@drawable/ic_back" />


    <!-- ========================================================= -->
    <!-- HEADER -->
    <!-- ========================================================= -->

    <LinearLayout

        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:orientation="vertical"

        android:paddingStart="20dp"
        android:paddingTop="16dp"
        android:paddingEnd="20dp"
        android:paddingBottom="10dp">


        <TextView

            android:id="@+id/tvTeamHeading"

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:textStyle="bold"
            android:textSize="19sp"

            android:textColor="@color/text_primary"

            android:maxLines="2"
            android:ellipsize="end"

            tools:text="Select Playing XI &amp; Substitutes for RCB" />


        <TextView

            android:id="@+id/tvHint"

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="5dp"

            android:text="Select exactly 15 players: 11 Playing XI + 4 substitutes"

            android:textSize="13sp"

            android:textColor="@color/text_secondary" />


        <TextView

            android:id="@+id/tvSelectedCount"

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="6dp"

            android:text="Selected: 0 / 15"

            android:textStyle="bold"
            android:textSize="14sp"

            android:textColor="@color/primary" />

    </LinearLayout>


    <!-- ========================================================= -->
    <!-- PLAYER LIST -->
    <!-- ========================================================= -->

    <androidx.recyclerview.widget.RecyclerView

        android:id="@+id/recyclerPlayers"

        android:layout_width="match_parent"
        android:layout_height="0dp"

        android:layout_weight="1"

        android:clipToPadding="false"

        android:paddingTop="4dp"
        android:paddingBottom="8dp"

        android:scrollbars="vertical" />


    <!-- ========================================================= -->
    <!-- CONFIRM BUTTON -->
    <!-- ========================================================= -->

    <com.google.android.material.button.MaterialButton

        android:id="@+id/btnConfirm"

        style="@style/PrimaryButton"

        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:layout_marginStart="20dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="20dp"

        android:minHeight="52dp"

        android:text="Confirm 15 Players"

        android:textColor="@color/white" />

</LinearLayout>