<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:layout_width="match_parent"
    android:layout_height="match_parent"

    android:background="@color/background"

    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">


        <!-- ===================================================== -->
        <!-- TOOLBAR -->
        <!-- ===================================================== -->

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"

            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"

            android:background="@color/primary"

            app:title="@string/settings"
            app:titleTextAppearance="@style/Toolbar.Title"
            app:navigationIcon="@drawable/ic_back" />


        <!-- ===================================================== -->
        <!-- APPEARANCE -->
        <!-- ===================================================== -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:layout_marginStart="20dp"
            android:layout_marginTop="22dp"
            android:layout_marginBottom="8dp"

            android:text="APPEARANCE"
            android:textColor="@color/primary"
            android:textSize="12sp"
            android:textStyle="bold" />


        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"

            app:cardBackgroundColor="@color/surface"
            app:cardCornerRadius="14dp"
            app:cardElevation="1dp">


            <LinearLayout
                android:id="@+id/rowTheme"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:orientation="horizontal"
                android:gravity="center_vertical"

                android:clickable="true"
                android:focusable="true"

                android:background="?attr/selectableItemBackground"

                android:padding="17dp">


                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"

                    android:src="@drawable/ic_settings"
                    android:tint="@color/primary"

                    android:contentDescription="@null" />


                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"

                    android:layout_weight="1"
                    android:layout_marginStart="15dp"

                    android:orientation="vertical">


                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"

                        android:text="Theme"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />


                    <TextView
                        android:id="@+id/tvCurrentTheme"

                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"

                        android:layout_marginTop="3dp"

                        android:text="System default"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />

                </LinearLayout>


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:text="›"
                    android:textColor="@color/text_secondary"
                    android:textSize="26sp" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>


        <!-- ===================================================== -->
        <!-- DATA MANAGEMENT -->
        <!-- ===================================================== -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:layout_marginStart="20dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="8dp"

            android:text="DATA MANAGEMENT"
            android:textColor="@color/primary"
            android:textSize="12sp"
            android:textStyle="bold" />


        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"

            app:cardBackgroundColor="@color/surface"
            app:cardCornerRadius="14dp"
            app:cardElevation="1dp">


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:orientation="vertical">


                <!-- RESET MATCH HISTORY -->

                <LinearLayout
                    android:id="@+id/rowClearHistory"

                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:orientation="horizontal"
                    android:gravity="center_vertical"

                    android:clickable="true"
                    android:focusable="true"

                    android:background="?attr/selectableItemBackground"

                    android:padding="17dp">


                    <ImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"

                        android:src="@drawable/ic_delete"

                        android:contentDescription="@null" />


                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"

                        android:layout_weight="1"
                        android:layout_marginStart="15dp"

                        android:orientation="vertical">


                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"

                            android:text="Reset Match History"
                            android:textColor="@color/text_primary"
                            android:textSize="15sp"
                            android:textStyle="bold" />


                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"

                            android:layout_marginTop="3dp"

                            android:text="Delete saved matches and match statistics"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp" />

                    </LinearLayout>

                </LinearLayout>


                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/divider" />


                <!-- RESET PLAYER RECORDS -->

                <LinearLayout
                    android:id="@+id/rowResetPlayerRecords"

                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:orientation="horizontal"
                    android:gravity="center_vertical"

                    android:clickable="true"
                    android:focusable="true"

                    android:background="?attr/selectableItemBackground"

                    android:padding="17dp">


                    <ImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"

                        android:src="@drawable/ic_player"
                        android:tint="@color/primary"

                        android:contentDescription="@null" />


                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"

                        android:layout_weight="1"
                        android:layout_marginStart="15dp"

                        android:orientation="vertical">


                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"

                            android:text="Reset Player Records"
                            android:textColor="@color/text_primary"
                            android:textSize="15sp"
                            android:textStyle="bold" />


                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"

                            android:layout_marginTop="3dp"

                            android:text="Clear career statistics while keeping players"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp" />

                    </LinearLayout>

                </LinearLayout>


                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/divider" />


                <!-- RESET ALL DATA -->

                <LinearLayout
                    android:id="@+id/rowResetAll"

                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:orientation="horizontal"
                    android:gravity="center_vertical"

                    android:clickable="true"
                    android:focusable="true"

                    android:background="?attr/selectableItemBackground"

                    android:padding="17dp">


                    <ImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"

                        android:src="@drawable/ic_delete"

                        android:contentDescription="@null" />


                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"

                        android:layout_weight="1"
                        android:layout_marginStart="15dp"

                        android:orientation="vertical">


                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"

                            android:text="Reset All Data"
                            android:textColor="@color/text_primary"
                            android:textSize="15sp"
                            android:textStyle="bold" />


                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"

                            android:layout_marginTop="3dp"

                            android:text="Delete teams, players, matches and statistics"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp" />

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

        </androidx.cardview.widget.CardView>


        <!-- ===================================================== -->
        <!-- INFORMATION -->
        <!-- ===================================================== -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:layout_marginStart="20dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="8dp"

            android:text="INFORMATION"
            android:textColor="@color/primary"
            android:textSize="12sp"
            android:textStyle="bold" />


        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="24dp"

            app:cardBackgroundColor="@color/surface"
            app:cardCornerRadius="14dp"
            app:cardElevation="1dp">


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:orientation="vertical">


                <!-- ABOUT US -->

                <LinearLayout
                    android:id="@+id/rowAbout"

                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:orientation="horizontal"
                    android:gravity="center_vertical"

                    android:clickable="true"
                    android:focusable="true"

                    android:background="?attr/selectableItemBackground"

                    android:padding="17dp">


                    <ImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"

                        android:src="@drawable/ic_stats"
                        android:tint="@color/primary"

                        android:contentDescription="@null" />


                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"

                        android:layout_weight="1"
                        android:layout_marginStart="15dp"

                        android:text="About Us"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                </LinearLayout>


                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/divider" />


                <!-- PRIVACY NOTICE -->

                <LinearLayout
                    android:id="@+id/rowPrivacy"

                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:orientation="horizontal"
                    android:gravity="center_vertical"

                    android:clickable="true"
                    android:focusable="true"

                    android:background="?attr/selectableItemBackground"

                    android:padding="17dp">


                    <ImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"

                        android:src="@drawable/ic_settings"
                        android:tint="@color/primary"

                        android:contentDescription="@null" />


                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"

                        android:layout_weight="1"
                        android:layout_marginStart="15dp"

                        android:text="Privacy Notice"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                </LinearLayout>


                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/divider" />


                <!-- TERMS OF SERVICE -->

                <LinearLayout
                    android:id="@+id/rowTerms"

                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:orientation="horizontal"
                    android:gravity="center_vertical"

                    android:clickable="true"
                    android:focusable="true"

                    android:background="?attr/selectableItemBackground"

                    android:padding="17dp">


                    <ImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"

                        android:src="@drawable/ic_history"
                        android:tint="@color/primary"

                        android:contentDescription="@null" />


                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"

                        android:layout_weight="1"
                        android:layout_marginStart="15dp"

                        android:text="Terms of Service"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

    </LinearLayout>

</ScrollView>